# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- llama.cpp server ---
LLAMA_SERVER_HOST=llama-server
LLAMA_SERVER_PORT=8081
MODEL_PATH=/models/llama-3.1-8b-instruct.Q4_K_M.gguf
CONTEXT_SIZE=8192

# --- API layer ---
API_HOST=0.0.0.0
API_PORT=8080
API_KEYS=                    # comma-separated list, e.g. key1,key2 - leave blank to disable auth for local dev
RATE_LIMIT_PER_MINUTE=60

# --- RAG layer (optional) ---
ENABLE_RAG=false
VECTOR_STORE_PATH=./data/vectorstore
WEB_SEARCH_API_KEY=          # only needed if using live web search retrieval
WEB_SEARCH_PROVIDER=         # e.g. "brave", "serper" - your choice, self-configured
